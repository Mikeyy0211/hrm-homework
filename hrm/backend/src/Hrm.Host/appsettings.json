{
  "Json": {
    "IgnoreNull": true,
    "NamingPolicy": "CamelCase"
  },
  "Cors": {
    "Frontend": {
      "AllowAnyOrigin": false,
      "AllowedOrigins": ["http://localhost:4173", "https://localhost:4173"],
      "AllowedAllHeaders": true,
      "AllowedAllMethods": true,
      "AllowCredentials": false
    }
  },
  "Swagger": {
    "Enable": true,
    "Versions": ["v1"],
    "ApiResponseDocumentationPathPrefixes": ["/api"]
  },
  "Middlewares": {
    "ApiResponseWrapper": {
      "IsEnable": true,
      "Includes": ["^/api"]
    }
  },
  "HealthChecks": {
    "DefaultTimeoutSeconds": 5,
    "MarkStartupCompleteOnApplicationStarted": true,
    "EnablePrometheusMetrics": true,
    "PrometheusMetricsPath": "/health/prometheus",
    "Readiness": {}
  },
  "OTEL": {
    "Name": "hrm",
    "Tracing": {
      "Endpoint": "",
      "Sampler": "ParentBasedRatio",
      "TraceIdRatio": 1.0,
      "AspNetCoreInstrumentation": {
        "ExcludedPathPrefixes": ["/health", "/swagger"]
      }
    },
    "Metric": {
      "Endpoint": ""
    },
    "Logging": {
      "Endpoint": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
